# Copy to .env and fill in ONE provider key. With no key, the API runs in demo mode.
# (Keep comments on their own lines: docker --env-file does not strip inline comments.)

# groq | gemini | openrouter | openai
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional: override the provider's default model
LLM_MODEL=

# true = canned responses, no API calls
DEMO_MODE=false

# Run original and rewritten code on LLM-generated test inputs to confirm the
# refactor behaves the same. Executes submitted code in a limited subprocess.
EQUIVALENCE_CHECK=true
